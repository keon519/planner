# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — for the free-readings lookup.
# OpenAlex and Unpaywall both ask for a contact email; it gets you the faster,
# more reliable request pool. Unpaywall won't work without it.
CONTACT_EMAIL=you@example.edu

# Optional — free key from https://core.ac.uk/services/api
CORE_API_KEY=

# Optional — Anthropic Usage & Cost API. Separate credential from the key above,
# and not available to every account type.
ANTHROPIC_ADMIN_KEY=
